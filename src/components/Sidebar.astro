---
import { sections } from '../data/links';
import { navGroups } from '../data/navigation';
import { ui } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  baseUrl?: string;
}

const { lang = 'zh', baseUrl = '/cn' } = Astro.props;
const byId = new Map(sections.map((section) => [section.id, section]));

// 菜单项直接引用内容分区的 id，锚点不会失效；同名分区只保留首个入口。
const groups = navGroups.map((group) => ({
  ...group,
  items: group.sections
    .map((id) => byId.get(id))
    .filter((section) => section !== undefined)
    .map((section) => ({
      id: section.id,
      label: lang === 'zh' ? section.titleZh ?? section.title : section.title,
    }))
    .filter((item, index, all) => all.findIndex((x) => x.label === item.label) === index),
}));
---

<div class="sidebar-menu toggle-others fixed">
  <div class="sidebar-menu-inner">
    <header class="logo-env">
      <div class="logo">
        <a href={`${baseUrl}/`} class="logo-expanded">
          <img src="/assets/images/logo@2x.png" width="100%" alt="WebStack" />
        </a>
        <a href={`${baseUrl}/`} class="logo-collapsed">
          <img src="/assets/images/logo-collapsed@2x.png" width="40" alt="WebStack" />
        </a>
      </div>
      <div class="mobile-menu-toggle visible-xs">
        <a href="#" data-toggle="user-info-menu" aria-label="Menu">
          <i class="linecons-cog"></i>
        </a>
        <a href="#" data-toggle="mobile-menu" aria-label="Menu">
          <i class="fa-bars"></i>
        </a>
      </div>
    </header>
    <ul id="main-menu" class="main-menu">
      {
        groups.map((group) => (
          <li>
            <a>
              <i class={`linecons-${group.icon}`}></i>
              <span class="title">{group.title[lang]}</span>
            </a>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={`#${item.id}`} class="smooth">
                    <span class="title">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
      <li>
        <a href={`${baseUrl}/about/`}>
          <i class="linecons-heart"></i>
          <span class="title">{ui[lang].about}</span>
        </a>
      </li>
    </ul>
  </div>
</div>
