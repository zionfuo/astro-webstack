---
import type { LinkItem } from '../data/links';

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;
const tooltip = link.tooltip ?? link.url;
---

<div
  class="xe-widget xe-conversations box2 label-info"
  data-toggle="tooltip"
  data-placement="bottom"
  title=""
  data-original-title={tooltip}
>
  <div class="xe-comment-entry">
    <span class="xe-user-img">
      {
        link.logo ? (
          <img
            src={link.logo}
            class="img-circle"
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
            alt=""
          />
        ) : (
          <span class="logo-fallback" aria-hidden="true">{link.name.charAt(0)}</span>
        )
      }
    </span>
    {
      link.badge && (
        <span
          class="label label-info"
          data-toggle="tooltip"
          data-placement="left"
          title=""
          data-original-title="Hello I am a Tooltip"
        />
      )
    }
    <div class="xe-comment">
      <span class="xe-user-name overflowClip_1"><strong>{link.name}</strong></span>
      <p class="overflowClip_2">{link.desc}</p>
    </div>
  </div>
  <a
    class="xe-widget-link"
    href={link.url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={link.name}
  ></a>
</div>
